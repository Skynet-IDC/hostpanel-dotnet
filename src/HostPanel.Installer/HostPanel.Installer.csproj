<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hostpanel-installer</AssemblyName>
    <RootNamespace>HostPanel.Installer</RootNamespace>

    <!-- F3 web installer ships as a single self-contained linux-x64 binary so the
         operator doesn't need a dotnet SDK on the target box. These flags only kick
         in for `dotnet publish`; plain `dotnet build` stays a framework-dependent
         build for fast local iteration. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed the bash installer so a single self-contained binary can extract
         + execute it at install time. Stage 4 layer 2. Path is relative to repo
         root because the csproj is two levels deep (src/HostPanel.Installer/). -->
    <EmbeddedResource Include="..\..\installer\hostpanel-install.sh" LogicalName="hostpanel-install.sh" />
  </ItemGroup>

  <ItemGroup>
    <!-- YamlDotNet for the config flag and Save-my-answers export. -->
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

</Project>
