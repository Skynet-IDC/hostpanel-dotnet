{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=HostPanel;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "CHANGE-THIS-TO-A-SECURE-KEY-AT-LEAST-32-CHARS-LONG-FOR-PRODUCTION",
    "Issuer": "HostPanel",
    "Audience": "HostPanel",
    "ExpiryHours": "24"
  },
  "Admin": {
    "Email": "admin@hostpanel.local",
    "Password": "REDACTED-PASSWORD"
  },
  "Cors": {
    "Origins": ["http://localhost:5173"]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Sso": {
    "Authentik": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": ""
    },
    "DefaultRole": "Customer"
  },
  "Dns": {
    "PowerDns": { "ApiUrl": "http://127.0.0.1:8081", "ApiKey": "", "ServerId": "localhost" },
    "Cloudflare": { "ApiToken": "" }
  },
  "Billing": {
    "PayPal": { "ClientId": "", "ClientSecret": "", "UseSandbox": true },
    "Stripe": { "SecretKey": "" }
  },
  "Databases": {
    "MsSql": { "ConnectionString": "Server=localhost;Trusted_Connection=True;TrustServerCertificate=True;" },
    "MySql": { "Host": "localhost", "RootUser": "root", "RootPassword": "" },
    "PostgreSql": { "Host": "localhost" },
    "Sqlite": { "BasePath": "/var/lib/hostpanel/sqlite" }
  },
  "Ssl": {
    "CertPath": "/etc/hostpanel/ssl",
    "AccountEmail": "admin@hostpanel.local",
    "UseStaging": true
  },
  "Mail": {
    "Webmail": { "Type": "roundcube", "InternalUrl": "http://127.0.0.1:9080" }
  },
  "Agent": {
    "SocketPath": "/var/run/hostpanel/agent.sock",
    "Token": ""
  },
  "Backup": {
    "BasePath": "/var/backups/hostpanel"
  },
  "AllowedHosts": "*"
}
